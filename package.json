{
  "name": "express-cec",
  "version": "0.2.0",
  "description": "Trigger CEC commands to a display using a REST API",
  "main": "node server.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch server.ts",
    "start": "node ./dist/server.js",
    "format": "npx prettier . --write",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs"
  },
  "keywords": [
    "av",
    "control",
    "cec",
    "raspberrypi",
    "tv"
  ],
  "author": "Zachary Klosko",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "conf": "^15.1.0",
    "fastify": "^5.12.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
